        "\n",
        "            plt.xlabel(\"Generation\")\n",
        "            plt.ylabel(\"100% Coverage Count\")\n",
        "            # MỚI: Sử dụng checkpoint_name (từ CUSTOM_LABELS) trong tiêu đề\n",
