      "source": [
        "# @title\n",
        "import pandas as pd\n",
        "\n",
        "def logbook_to_dataframe(logbook):\n",
        "    \"\"\"\n",
        "    Chuyển logbook của DEAP thành pandas.DataFrame có cấu trúc phẳng\n",
        "    và đổi tên cột cho dễ đọc.\n",
        "    \"\"\"\n",
        "    # Lấy danh sách bản ghi (mỗi phần tử là 1 dict)\n",
        "    records = logbook.select(\"gen\")  # để đảm bảo logbook không rỗng\n",
        "\n",
        "    # Logbook lưu dữ liệu theo dạng list các dict\n",
        "    # Dùng .chapters để truy cập từng nhóm như obj1, obj2, ...\n",
        "    dataframes = []\n",
        "    column_mapping = {\n",
        "        'obj1': 'coverage',\n",
        "        'obj2': 'altitude',\n",
        "        'obj3': 'costs'\n",
        "    }\n",
        "    # Các cột muốn giữ lại ở cấp gốc (không thêm prefix)\n",
        "    base_cols = ['gen', 'nevals', 'new_hof']\n",
        "\n",
        "\n",
        "    # Nếu logbook có chia thành nhiều chương (chapter)\n",
        "    if hasattr(logbook, \"chapters\") and logbook.chapters:\n",
        "        for name, chapter in logbook.chapters.items():\n",
        "            df = pd.DataFrame(chapter)\n",
        "            # Đổi tên cột dựa trên mapping, bỏ qua các cột base_cols\n",
        "            new_name = column_mapping.get(name, name) # Sử dụng tên cũ nếu không có trong mapping\n",
        "            df = df.rename(columns={col: f\"{new_name}_{col}\" for col in df.columns if col not in base_cols})\n",
        "            dataframes.append(df)\n",
        "        # Ghép các chapter theo cột\n",
        "        # Chỉ lấy các cột không phải base_cols từ các chapter con\n",
        "        chapter_dfs = [df[[col for col in df.columns if col not in base_cols]] for df in dataframes]\n",
        "        df_full = pd.concat(chapter_dfs, axis=1)\n",
        "    else:\n",
        "         # Nếu logbook chỉ là 1 chương duy nhất\n",
        "        df_full = pd.DataFrame(logbook)\n",
        "        # Đổi tên cột cho các mục tiêu chính nếu có (trường hợp này ít xảy ra với MultiStatistics)\n",
        "        df_full = df_full.rename(columns={f.name: column_mapping.get(f.name, f.name) for f in stats.chapters})\n",
        "\n",
        "\n",
        "    # Xử lý các cột base_cols từ logbook chính\n",
        "    base_data = {col: logbook.select(col) for col in base_cols if col in logbook[0]}\n",
        "    df_base = pd.DataFrame(base_data)\n",
        "\n",
        "    # Ghép cột gen từ df_base nếu chưa có\n",
        "    if 'gen' not in df_full.columns and 'gen' in df_base.columns:\n",
        "         df_full.insert(0, 'gen', df_base['gen'])\n",
        "         df_base = df_base.drop(columns=['gen']) # Xóa khỏi df_base để tránh trùng khi concat\n",
        "\n",
        "\n",
        "    # Đặt cột 'new_hof' ngay sau 'gen'\n",
        "    if 'new_hof' in df_base.columns:\n",
        "        new_hof_col = df_base.pop('new_hof') # Tách cột new_hof\n",
        "        # Check if 'gen' is in df_full before inserting\n",
        "        if 'gen' in df_full.columns:\n",
        "            df_full.insert(df_full.columns.get_loc('gen') + 1, 'new_hof', new_hof_col) # Chèn vào vị trí mong muốn\n",
        "        else:\n",
        "             df_full.insert(0, 'new_hof', new_hof_col) # If 'gen' isn't there, just insert at the beginning\n",
        "\n",
        "\n",
        "\n",
        "    # Ghép các cột còn lại từ df_base\n",
        "    df_full = pd.concat([df_base, df_full], axis=1)\n",
        "\n",
        "\n",
        "    # Đảm bảo cột gen là cột đầu tiên\n",
        "    if 'gen' in df_full.columns:\n",
        "        gen_col = df_full.pop('gen')\n",
        "        df_full.insert(0, 'gen', gen_col)\n",
        "\n",
        "\n",
        "    return df_full\n",
        "\n",
        "# Create a dictionary to store logbook dataframes from each checkpoint\n",
        "logbook_dataframes = {}\n",
        "\n",
        "# Iterate through the loaded checkpoints data\n",
        "for checkpoint_key, data in loaded_checkpoints_data.items(): # Iterate using the extracted integer key\n",
        "    logbook = data[\"logbook\"]\n",
        "    # Convert the logbook to a dataframe and store it in the dictionary\n",
        "    # Use the checkpoint_key (which is the extracted integer) as the dictionary key\n",
        "    logbook_dataframes[checkpoint_key] = logbook_to_dataframe(logbook)\n",
        "\n",
