        "    print(f\"⚠️ Checkpoint key '{checkpoint_key_to_standardize_back}' not found in loaded_checkpoints_data.\")\n",
        "\n",
        "# You can now verify the format by inspecting loaded_checkpoints_data[2016]['pop_history']\n",
