        "# @title\n",
        "def tle_checksum(line: str) -> str:\n",
        "    checksum = 0\n",
        "    # Chỉ duyệt qua 68 ký tự đầu tiên\n",
        "    for char in line[:68]:\n",
        "        if '0' <= char <= '9':\n",
        "            checksum += int(char)\n",
        "        elif char == '-':\n",
        "            checksum += 1\n",
        "\n",
        "    return str(checksum % 10)"
      ]
    },
