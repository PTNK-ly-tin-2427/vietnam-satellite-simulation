      "source": [
        "# @title\n",
        "import pandas as pd\n",
        "import re # Import re module\n",
        "\n",
        "def analyze_pairwise_hof_proportions(nested_pairwise_combined_hof_dfs):\n",
        "    \"\"\"\n",
        "    Analyzes the proportion of individuals from checkpoint 0 and another\n",
        "    checkpoint within their pairwise combined Hall of Fame DataFrames.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    nested_pairwise_combined_hof_dfs : dict\n",
        "        A nested dictionary where keys are base_checkpoint_keys and values\n",
        "        are dictionaries containing comparison_name: DataFrame pairs.\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    dict\n",
        "        A dictionary where keys are comparison names (e.g., \"test_0_vs_test_80\")\n",
        "        and values are pandas DataFrames. Each DataFrame has two columns\n",
        "        ('Test X Proportion', 'Test Y Proportion') and two rows:\n",
        "        - Row 1: Proportion in the full combined Pareto front.\n",
        "        - Row 2: Proportion in the 100% coverage subset of the combined Pareto front.\n",
        "    \"\"\"\n",
        "    analysis_results = {}\n",
        "    if not nested_pairwise_combined_hof_dfs:\n",
        "        print(\"Không có dữ liệu Hall of Fame tổng hợp theo cặp để phân tích.\")\n",
        "        return analysis_results\n",
        "\n",
        "    # Iterate through the outer dictionary (base_checkpoint_key)\n",
        "    for base_key, comparisons_dict in nested_pairwise_combined_hof_dfs.items():\n",
        "        # Iterate through the inner dictionary (comparison_name: DataFrame)\n",
        "        for comparison_name, combined_hof_df in comparisons_dict.items():\n",
        "            # Extract the checkpoint keys from the comparison name for column naming\n",
        "            match = re.match(r'checkpoint_final_constraint_(\\d+)\\.pkl_vs_checkpoint_final_constraint_(\\d+)\\.pkl', comparison_name)\n",
        "            if match:\n",
        "                key1 = int(match.group(1))\n",
        "                key2 = int(match.group(2))\n",
        "                col1_name = f\"Test {key1} Proportion\"\n",
        "                col2_name = f\"Test {key2} Proportion\"\n",
        "                analysis_key_name = f\"test_{key1}_vs_test_{key2}\"\n",
        "            else:\n",
        "                # Fallback naming if parsing fails\n",
        "                # This case should ideally not be hit if comparison_name format is consistent\n",
        "                col1_name = \"Checkpoint 1 Proportion\"\n",
        "                col2_name = \"Checkpoint 2 Proportion\"\n",
        "                analysis_key_name = comparison_name.replace('.pkl', '').replace('checkpoint_final_constraint_', '').replace('_vs_', '_vs_')\n",
        "                print(f\"⚠️ Could not parse checkpoint keys from comparison name: {comparison_name}. Using modified name for analysis key.\")\n",
        "\n",
        "\n",
        "            # Initialize data for the DataFrame\n",
        "            data = {}\n",
        "            data[col1_name] = []\n",
        "            data[col2_name] = []\n",
        "            index_names = []\n",
        "\n",
        "            # --- Analysis 1: Full Combined Pareto Front ---\n",
        "            total_individuals = len(combined_hof_df)\n",
        "            if total_individuals > 0:\n",
        "                # Use .str.contains with the actual filename pattern and raw strings\n",
        "                count_cp1 = len(combined_hof_df[combined_hof_df['Checkpoint_File'].str.contains(rf'constraint_{key1}\\.pkl', na=False)])\n",
        "                count_cp2 = len(combined_hof_df[combined_hof_df['Checkpoint_File'].str.contains(rf'constraint_{key2}\\.pkl', na=False)])\n",
        "                prop_cp1 = count_cp1 / total_individuals\n",
        "                prop_cp2 = count_cp2 / total_individuals\n",
        "            else:\n",
        "                prop_cp1 = 0.0\n",
        "                prop_cp2 = 0.0\n",
        "\n",
        "            data[col1_name].append(prop_cp1)\n",
        "            data[col2_name].append(prop_cp2)\n",
        "            index_names.append(f\"Full Pareto Front Proportion ({total_individuals} individuals)\")\n",
        "\n",
        "            # --- Analysis 2: 100% Coverage Subset ---\n",
        "            coverage_100_df = combined_hof_df[combined_hof_df['Fitness (Coverage)'] >= 1.0].copy()\n",
        "            total_individuals_100 = len(coverage_100_df)\n",
        "\n",
        "            if total_individuals_100 > 0:\n",
        "                count_cp1_100 = len(coverage_100_df[coverage_100_df['Checkpoint_File'].str.contains(rf'constraint_{key1}\\.pkl', na=False)])\n",
        "                count_cp2_100 = len(coverage_100_df[coverage_100_df['Checkpoint_File'].str.contains(rf'constraint_{key2}\\.pkl', na=False)])\n",
        "                # print(f\"\\n{total_individuals_100}\")\n",
        "                # print(f\"{col1_name}: {count_cp1_100}\")\n",
        "                # print(f\"{col2_name}: {count_cp2_100}\")\n",
        "                # print(f\"{col1_name} Proportion: {count_cp1_100 / total_individuals_100}\")\n",
        "                # print(f\"{col2_name} Proportion: {count_cp2_100 / total_individuals_100}\")\n",
        "                prop_cp1_100 = count_cp1_100 / total_individuals_100\n",
        "                prop_cp2_100 = count_cp2_100 / total_individuals_100\n",
        "            else:\n",
        "                prop_cp1_100 = 0.0\n",
        "                prop_cp2_100 = 0.0\n",
        "\n",
        "            data[col1_name].append(prop_cp1_100)\n",
        "            data[col2_name].append(prop_cp2_100)\n",
        "            index_names.append(f\"100% Coverage Proportion ({total_individuals_100} individuals)\")\n",
        "\n",
        "            # Create the DataFrame for this comparison\n",
        "            comparison_df = pd.DataFrame(data, index=index_names)\n",
        "\n",
        "            # Store the DataFrame in the results dictionary\n",
        "            analysis_results[analysis_key_name] = comparison_df\n",
        "\n",
        "    return analysis_results\n",
        "\n",
        "def analyze_overall_combined_hof_proportions(combined_hall_of_fame_df, all_checkpoint_files):\n",
        "    \"\"\"\n",
        "    Analyzes the proportion of individuals from each original checkpoint\n",
        "    within the overall combined Hall of Fame DataFrame.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    combined_hall_of_fame_df : pandas.DataFrame\n",
        "        The DataFrame containing the overall Pareto front from all checkpoints.\n",
        "    all_checkpoint_files : list\n",
        "        A list of strings representing the original checkpoint file paths.\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    pandas.DataFrame\n",
        "        A DataFrame showing the proportion of individuals contributed by each\n",
        "        checkpoint to the full and 100% coverage subsets of the overall Pareto front.\n",
        "    \"\"\"\n",
        "    analysis_data = []\n",
        "    index_names = []\n",
        "\n",
        "    # Map checkpoint keys to their original filenames for easier lookup\n",
        "    checkpoint_label_mapping = {}\n",
        "    for f_key in CHECKPOINT_FILES:\n",
        "        match_str = rf'constraint_{f_key}\\.pkl'\n",
        "        if f_key == 2016:\n",
        "            match_str = r'constraint_2016\\.pkl'\n",
        "\n",
        "        # Find the actual filename from CHECKPOINT_FILE matching the key\n",
        "        actual_filename = None\n",
        "        for cp_path in all_checkpoint_files:\n",
        "            if re.search(match_str, os.path.basename(cp_path)):\n",
        "                actual_filename = os.path.basename(cp_path)\n",
        "                break\n",
        "        if actual_filename:\n",
        "             # Try to use CUSTOM_LABELS if available and matching\n",
        "            try:\n",
        "                label_index = CHECKPOINT_FILES.index(f_key)\n",
        "                checkpoint_label_mapping[actual_filename] = CUSTOM_LABELS[label_index]\n",
        "            except (ValueError, IndexError):\n",
        "                checkpoint_label_mapping[actual_filename] = f\"Test {f_key}\"\n",
        "\n",
        "\n",
        "    # Use the 'Checkpoint_File' column from the DataFrame directly\n",
        "    unique_checkpoint_origin_files = combined_hall_of_fame_df['Checkpoint_File'].unique()\n",
        "\n",
        "    # --- Analysis 1: Full Overall Combined Pareto Front ---\n",
        "    full_total = len(combined_hall_of_fame_df)\n",
        "    full_proportions = {}\n",
        "    if full_total > 0:\n",
        "        for cp_file_name in unique_checkpoint_origin_files:\n",
        "            count = len(combined_hall_of_fame_df[combined_hall_of_fame_df['Checkpoint_File'] == cp_file_name])\n",
        "            full_proportions[checkpoint_label_mapping.get(cp_file_name, cp_file_name)] = count / full_total\n",
        "    else:\n",
        "        for cp_file_name in unique_checkpoint_origin_files:\n",
        "            full_proportions[checkpoint_label_mapping.get(cp_file_name, cp_file_name)] = 0.0\n",
        "\n",
        "    analysis_data.append(full_proportions)\n",
        "    index_names.append(f\"Full Combined Pareto Front Proportion ({full_total} individuals)\")\n",
        "\n",
        "    # --- Analysis 2: 100% Coverage Subset of Overall Combined Pareto Front ---\n",
        "    coverage_100_df_overall = combined_hall_of_fame_df[combined_hall_of_fame_df['Fitness (Coverage)'] >= 1.0].copy()\n",
        "    cov_100_total = len(coverage_100_df_overall)\n",
        "    cov_100_proportions = {}\n",
        "    if cov_100_total > 0:\n",
        "        for cp_file_name in unique_checkpoint_origin_files:\n",
        "            count = len(coverage_100_df_overall[coverage_100_df_overall['Checkpoint_File'] == cp_file_name])\n",
        "            cov_100_proportions[checkpoint_label_mapping.get(cp_file_name, cp_file_name)] = count / cov_100_total\n",
        "    else:\n",
        "        for cp_file_name in unique_checkpoint_origin_files:\n",
        "            cov_100_proportions[checkpoint_label_mapping.get(cp_file_name, cp_file_name)] = 0.0\n",
        "\n",
        "    analysis_data.append(cov_100_proportions)\n",
        "    index_names.append(f\"100% Coverage Combined Pareto Front Proportion ({cov_100_total} individuals)\")\n",
        "\n",
        "    # Create DataFrame\n",
        "    overall_proportion_df = pd.DataFrame(analysis_data, index=index_names)\n",
        "\n",
        "    # Sort columns by checkpoint key (extract number from 'Test X' string or use custom label order)\n",
        "    def get_sort_key_for_col(col_name):\n",
        "        # Check if it's one of the custom labels\n",
        "        if col_name in CUSTOM_LABELS:\n",
        "            return CUSTOM_LABELS.index(col_name)\n",
        "        # If not, try to extract 'Test X' number\n",
        "        match = re.search(r'Test (\\d+)', col_name)\n",
        "        if match:\n",
        "            return int(match.group(1))\n",
        "        return float('inf') # Put non-matching columns at the end\n",
        "\n",
        "    overall_proportion_df = overall_proportion_df.reindex(sorted(overall_proportion_df.columns, key=get_sort_key_for_col), axis=1)\n",
        "\n",
        "    return overall_proportion_df\n",
        "\n",
        "# Example usage (assuming pairwise_combined_hof_dfs is defined in a previous cell):\n",
        "analysis_dfs = analyze_pairwise_hof_proportions(pairwise_combined_hof_dfs)\n",
        "\n",
        "# Call the new function for the overall combined HOF\n",
        "if 'combined_hall_of_fame_df' in locals() and not combined_hall_of_fame_df.empty:\n",
        "    print(\"\\nAnalysis of Overall Combined Pareto Front Proportions:\")\n",
        "    # Need to pass the original CHECKPOINT_FILE list for mapping\n",
        "    overall_proportions_df = analyze_overall_combined_hof_proportions(combined_hall_of_fame_df, CHECKPOINT_FILE)\n",
        "    display(overall_proportions_df)\n",
        "else:\n",
        "    print(\"⚠️ 'combined_hall_of_fame_df' not found or is empty. Cannot analyze overall proportions.\")\n",
        "\n",
        "\n",
        "# Display the resulting dictionary of DataFrames\n",
        "print(\"\\nAnalysis Results:\")\n",
        "for key, df in analysis_dfs.items():\n",
        "    print(f\"\\nComparison: {key}\")\n",
        "    display(df)"
      ]
    },
